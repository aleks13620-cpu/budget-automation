# price-harvester — окружение. Скопируй в .env и подставь значения. Секреты НЕ коммить.

# --- Общая БД бэкенда (SQLite). По умолчанию — соседняя БД проекта. ---
BUDGET_DB_PATH=../database/budget_automation.db

# --- Какой проект собираем. Пусто = автоматически берётся реальный проект с макс. числом позиций. ---
PROJECT_ID=

# --- Параметры пилота ---
PILOT_LIMIT=5            # сколько позиций брать для проверочного прогона
PILOT_CATEGORY=          # пусто = счётчики+арматура+отопление; или: арматура / счетчики / вентиляция …
TOP_N_OFFERS=3           # сколько лучших предложений хранить на позицию
MATCH_THRESHOLD=0.55     # порог схожести «предложение ↔ позиция»

# --- Вежливость сбора (ядро rest_client; см. references/anti_bot.md) ---
MIN_DELAY_SEC=2.0        # минимальная пауза между живыми запросами к одному источнику
TIMEOUT_SEC=30
MAX_RETRIES=5
ACCEPT_LANGUAGE=ru-RU,ru;q=0.9
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
